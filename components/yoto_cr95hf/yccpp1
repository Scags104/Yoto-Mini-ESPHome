#include "yoto_cr95hf.h"

#include <cstdio>

#include "esphome/core/hal.h"
#include "esphome/core/log.h"

namespace esphome {
namespace yoto_cr95hf {

static const char *const TAG = "yoto_cr95hf";

// CR95HF commands
static const uint8_t CMD_IDN = 0x01;
static const uint8_t CMD_PROTOCOL_SELECT = 0x02;
static const uint8_t CMD_SEND_RECV = 0x04;
static const uint8_t CMD_ECHO = 0x55;

// CR95HF result codes
static const uint8_t RES_OK = 0x00;
static const uint8_t RES_FRAME_OK = 0x80;
static const uint8_t RES_NO_TAG = 0x87;  // tag did not respond (timeout)

// Wake: stock firmware retries Echo up to 530 times, 10 ms apart
static const uint32_t WAKE_MAX_ATTEMPTS = 530;
static const uint32_t WAKE_INTERVAL_MS = 10;
static const uint32_t WAKE_BACKOFF_MS = 5000;

// Removal policy (matches Open Yoto): 2 no-response polls or 21 driver errors
static const uint8_t REMOVE_AFTER_MISSES = 2;
static const uint8_t RESET_AFTER_ERRORS = 21;

void CR95HFComponent::setup() {
  this->status_set_warning("Waking CR95HF");
  this->flush_rx_();
  this->last_wake_tx_ = millis() - WAKE_INTERVAL_MS;
}

void CR95HFComponent::loop() {
  if (this->state_ != State::WAKING)
    return;

  const uint32_t now = millis();
  if (static_cast<int32_t>(now - this->wake_hold_until_) < 0)
    return;

  // Any Echo reply means the reader is awake
  while (this->available()) {
    uint8_t b;
    this->read_byte(&b);
    if (b == CMD_ECHO) {
      ESP_LOGD(TAG, "CR95HF answered Echo after %u attempt(s)", (unsigned) this->wake_attempts_);
      this->wake_attempts_ = 0;
      if (this->init_reader_()) {
        this->state_ = State::READY;
        this->status_clear_warning();
        ESP_LOGI(TAG, "CR95HF ready: %s", this->idn_.c_str());
      } else {
        this->restart_wake_("initialisation failed");
      }
      return;
    }
  }

  if (now - this->last_wake_tx_ >= WAKE_INTERVAL_MS) {
    if (this->wake_attempts_ >= WAKE_MAX_ATTEMPTS) {
      ESP_LOGW(TAG, "No Echo reply after %u attempts; retrying in %u s", (unsigned) WAKE_MAX_ATTEMPTS,
               (unsigned) (WAKE_BACKOFF_MS / 1000));
      this->wake_attempts_ = 0;
      this->wake_hold_until_ = now + WAKE_BACKOFF_MS;
      return;
    }
    // The Echo byte's start bit also provides the falling edge that wakes a sleeping reader
    this->write_byte(CMD_ECHO);
    this->last_wake_tx_ = now;
    this->wake_attempts_++;
  }
}

bool CR95HFComponent::init_reader_() {
  uint8_t result;
  std::vector<uint8_t> resp;

  // IDN: identifies the chip, e.g. "NFC FS2JAST4"
  if (!this->transceive_(CMD_IDN, {}, result, resp) || result != RES_OK) {
    ESP_LOGW(TAG, "IDN failed (result 0x%02X)", result);
    return false;
  }
  this->idn_.clear();
  for (uint8_t c : resp) {
    if (c == 0)
      break;
    if (c >= 0x20 && c < 0x7F)
      this->idn_ += static_cast<char>(c);
  }

  // ProtocolSelect: ISO14443-A, 106 kbps
  if (!this->transceive_(CMD_PROTOCOL_SELECT, {0x02, 0x00}, result, resp) || result != RES_OK) {
    ESP_LOGW(TAG, "ProtocolSelect ISO14443-A failed (result 0x%02X)", result);
    return false;
  }
  delay(10);  // settle after field-on, as Open Yoto does
  return true;
}

void CR95HFComponent::update() {
  if (this->state_ != State::READY)
    return;

  std::vector<uint8_t> uid;
  const ReadResult r = this->read_uid_(uid);

  if (r == ReadResult::TAG) {
    this->miss_count_ = 0;
    this->error_count_ = 0;
    const std::string uid_str = format_uid_(uid);
    if (uid_str != this->current_uid_) {
      if (!this->current_uid_.empty())
        this->fire_removed_(this->current_uid_);  // card swapped without a gap
      this->current_uid_ = uid_str;
      this->fire_tag_(uid_str);
    }
    return;
  }

  if (r == ReadResult::NO_TAG) {
    this->error_count_ = 0;
    if (!this->current_uid_.empty() && ++this->miss_count_ >= REMOVE_AFTER_MISSES) {
      this->miss_count_ = 0;
      const std::string old = this->current_uid_;
      this->current_uid_.clear();
      this->fire_removed_(old);
    }
    return;
  }

  // Driver error
  this->miss_count_ = 0;
  if (++this->error_count_ >= RESET_AFTER_ERRORS) {
    this->error_count_ = 0;
    if (!this->current_uid_.empty()) {
      const std::string old = this->current_uid_;
      this->current_uid_.clear();
      this->fire_removed_(old);
    }
    this->restart_wake_("too many driver errors");
  }
}

CR95HFComponent::ReadResult CR95HFComponent::read_uid_(std::vector<uint8_t> &uid) {
  uint8_t result = 0;
  std::vector<uint8_t> tb;

  // REQA wakes IDLE tags; WUPA also wakes tags we HALTed on the previous poll
  if (!this->send_recv_({0x26}, 0x07, result, tb) && result != RES_NO_TAG)
    return ReadResult::ERROR;
  if (result == RES_NO_TAG) {
    if (!this->send_recv_({0x52}, 0x07, result, tb) && result != RES_NO_TAG)
      return ReadResult::ERROR;
    if (result == RES_NO_TAG)
      return ReadResult::NO_TAG;
  }
  if (tb.size() < 2) {
    ESP_LOGV(TAG, "Short ATQA (%u bytes)", (unsigned) tb.size());
    return ReadResult::ERROR;
  }

  // Anticollision + select, cascade levels 1..3
  static const uint8_t SEL[3] = {0x93, 0x95, 0x97};
  uid.clear();
  bool complete = false;
  for (int level = 0; level < 3; level++) {
    std::vector<uint8_t> ac;
    if (!this->send_recv_({SEL[level], 0x20}, 0x08, result, ac) || ac.size() < 5) {
      ESP_LOGV(TAG, "Anticollision CL%d failed (result 0x%02X, %u bytes)", level + 1, result, (unsigned) ac.size());
      return ReadResult::ERROR;
    }
    const uint8_t bcc = ac[0] ^ ac[1] ^ ac[2] ^ ac[3];
    if (bcc != ac[4]) {
      ESP_LOGV(TAG, "BCC mismatch at CL%d", level + 1);
      return ReadResult::ERROR;
    }

    std::vector<uint8_t> sel_frame = {SEL[level], 0x70, ac[0], ac[1], ac[2], ac[3], ac[4]};
    std::vector<uint8_t> sak;
    if (!this->send_recv_(sel_frame, 0x28, result, sak) || sak.empty()) {
      ESP_LOGV(TAG, "Select CL%d failed (result 0x%02X)", level + 1, result);
      return ReadResult::ERROR;
    }

    if (ac[0] == 0x88) {
      // Cascade tag: three UID bytes at this level, more to follow
      uid.insert(uid.end(), ac.begin() + 1, ac.begin() + 4);
    } else {
      uid.insert(uid.end(), ac.begin(), ac.begin() + 4);
    }

    if ((sak[0] & 0x04) == 0) {
      complete = true;
      break;
    }
  }
  if (!complete)
    return ReadResult::ERROR;

  // HLTA: park the tag so the next poll needs WUPA (no reply expected)
  std::vector<uint8_t> ignored;
  this->send_recv_({0x50, 0x00}, 0x28, result, ignored);

  return ReadResult::TAG;
}

bool CR95HFComponent::send_recv_(const std::vector<uint8_t> &frame, uint8_t control, uint8_t &result,
                                 std::vector<uint8_t> &tag_bytes) {
  std::vector<uint8_t> data(frame);
  data.push_back(control);
  std::vector<uint8_t> resp;
  tag_bytes.clear();
  if (!this->transceive_(CMD_SEND_RECV, data, result, resp)) {
    result = 0xFF;
    return false;
  }
  if (result != RES_FRAME_OK)
    return false;
  // Response = tag bytes + 3 CR95HF status bytes
  if (resp.size() < 3)
    return false;
  tag_bytes.assign(resp.begin(), resp.end() - 3);
  return true;
}

bool CR95HFComponent::transceive_(uint8_t cmd, const std::vector<uint8_t> &data, uint8_t &result,
                                  std::vector<uint8_t> &resp, uint32_t timeout_ms) {
  this->flush_rx_();
  std::vector<uint8_t> frame;
  frame.reserve(data.size() + 2);
  frame.push_back(cmd);
  frame.push_back(static_cast<uint8_t>(data.size()));
  frame.insert(frame.end(), data.begin(), data.end());
  this->write_array(frame);

  const uint32_t deadline = millis() + timeout_ms;
  uint8_t len = 0;
  resp.clear();
  if (!this->read_byte_until_(result, deadline) || !this->read_byte_until_(len, deadline)) {
    ESP_LOGV(TAG, "Timeout waiting for reply to command 0x%02X", cmd);
    return false;
  }
  resp.resize(len);
  for (uint8_t i = 0; i < len; i++) {
    if (!this->read_byte_until_(resp[i], deadline)) {
      ESP_LOGV(TAG, "Truncated reply to command 0x%02X (%u of %u bytes)", cmd, i, len);
      return false;
    }
  }
  return true;
}

bool CR95HFComponent::read_byte_until_(uint8_t &b, uint32_t deadline) {
  while (static_cast<int32_t>(millis() - deadline) < 0) {
    if (this->available())
      return this->read_byte(&b);
    delay(1);
  }
  return false;
}

void CR95HFComponent::flush_rx_() {
  uint8_t b;
  while (this->available())
    this->read_byte(&b);
}

void CR95HFComponent::restart_wake_(const char *reason) {
  ESP_LOGW(TAG, "Re-waking CR95HF: %s", reason);
  this->state_ = State::WAKING;
  this->status_set_warning("Waking CR95HF");
  this->wake_attempts_ = 0;
  this->wake_hold_until_ = millis();
}

std::string CR95HFComponent::format_uid_(const std::vector<uint8_t> &uid) {
  std::string s;
  char buf[4];
  for (size_t i = 0; i < uid.size(); i++) {
    if (i > 0)
      s += '-';
    snprintf(buf, sizeof(buf), "%02X", uid[i]);
    s += buf;
  }
  return s;
}

void CR95HFComponent::fire_tag_(const std::string &uid) {
  ESP_LOGI(TAG, "Tag present: %s", uid.c_str());
  for (auto *t : this->tag_triggers_)
    t->trigger(uid);
}

void CR95HFComponent::fire_removed_(const std::string &uid) {
  ESP_LOGI(TAG, "Tag removed: %s", uid.c_str());
  for (auto *t : this->removed_triggers_)
    t->trigger(uid);
}

void CR95HFComponent::dump_config() {
  ESP_LOGCONFIG(TAG, "CR95HF NFC reader (UART):");
  ESP_LOGCONFIG(TAG, "  State: %s", this->state_ == State::READY ? "ready" : "waking");
  if (!this->idn_.empty())
    ESP_LOGCONFIG(TAG, "  IDN: %s", this->idn_.c_str());
  LOG_UPDATE_INTERVAL(this);
  this->check_uart_settings(57600, 2);
}

}  // namespace yoto_cr95hf
}  // namespace esphome
